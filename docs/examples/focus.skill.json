{
  "kind": "hext.skill",
  "version": 1,
  "id": "example.focus",
  "title": "Personal focus session",
  "description": "Start a timer and set Windows volume using the user's requested values. Each action remains permission checked.",
  "parameters": {
    "type": "object",
    "additionalProperties": false,
    "properties": {
      "minutes": {"type": "integer", "minimum": 1, "maximum": 1440},
      "percent": {"type": "integer", "minimum": 0, "maximum": 100}
    },
    "required": ["minutes", "percent"]
  },
  "steps": [
    {"name": "timer.start", "arguments": {"minutes": {"$input": "minutes"}}},
    {"name": "audio.set_volume", "arguments": {"percent": {"$input": "percent"}}}
  ]
}
